# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Production (Vercel): Set this in Project Settings > Environment Variables.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override (defaults to gemini-2.5-flash with safe fallback)
GEMINI_MODEL="gemini-2.5-flash"

# DEVELOPMENT ONLY: Optional fallback key for local testing when NODE_ENV !== "production".
# NEVER set or enable DEV_GEMINI_API_KEY in production deployments.
DEV_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
